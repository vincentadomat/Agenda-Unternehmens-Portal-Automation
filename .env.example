# Agenda Unternehmensportal – Zugangsdaten
# Diese Datei nach .env kopieren und ausfüllen. .env NICHT committen!

AGENDA_USERNAME=
AGENDA_PASSWORD=
# TOTP-Secret (Base32), wie in Apple Passwords / im Authenticator hinterlegt.
# Leerzeichen werden automatisch entfernt.
AGENDA_TOTP_SECRET=

# Optional: Ablageort für den Token-Cache (Default: ~/.cache/agenda/tokens.json)
# AGENDA_TOKEN_CACHE=/opt/agenda/tokens.json
